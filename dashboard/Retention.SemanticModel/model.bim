            "formatString": "0.00%",
            "description": "Single aggregate row only; blank for ambiguous alternatives or totals. model_evaluation.json / models / combined / calibrated"
          }
        ],
        "partitions": [
          {
            "name": "Overview",
            "mode": "import",
