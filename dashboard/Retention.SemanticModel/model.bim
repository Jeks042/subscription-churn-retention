            "description": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[assumed_absolute_effect]))"
          },
          {
            "name": "Selection status",
            "expression": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, \"One alternative selected | hypothetical CU\", \"Select one source, capacity, policy, value and scenario\")",
            "formatString": "",
            "description": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, \"One alternative selected | hypothetical CU\", \"Select one source, capacity, policy, value and scenario\")"
          }
        ],
