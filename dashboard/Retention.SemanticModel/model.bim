        "measures": [
          {
            "name": "Hypothetical net CU",
            "expression": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[net_contribution_cu]))",
            "formatString": "#,0;−#,0;0",
            "description": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[net_contribution_cu]))"
          },
          {
            "name": "Assumed cost CU",
            "expression": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[total_cost_cu]))",
            "formatString": "#,0",
            "description": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[total_cost_cu]))"
          },
          {
            "name": "Scenario conditional break-even",
            "expression": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[break_even_conditional_save]))",
            "formatString": "0.00%",
            "description": "IF(COUNTROWS('Profiles') = 1 && COUNTROWS('Scenario choices') = 1 && COUNTROWS('Scenarios') = 1, SELECTEDVALUE('Scenarios'[break_even_conditional_save]))"
          },
